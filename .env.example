# ============================================================
#  Configuracion de entorno - PLANTILLA
#  ------------------------------------------------------------
#  Copiar a .env.dev o .env.prod segun corresponda:
#    cp .env.example .env.dev    # desarrollo local (commiteado, valores seguros)
#    cp .env.example .env.prod   # produccion (GITIGNORED, llenar con secretos reales)
#
#  Las variables se cargan automaticamente con:
#    docker compose up -d                     # usa .env.dev por defecto
#    docker compose --env-file .env.prod ...  # prod
#  Ver DEPLOY.md para mas detalle.
# ============================================================

# ---------- Generales ----------
# TAG de imagen (latest / dev / prod / version-semver)
TAG=latest
# Archivo de entorno que docker-compose carga por defecto si no se especifica --env-file
ENV_FILE=.env.dev

# ---------- Puertos del host ----------
# Puerto para acceder al backend directamente (sin NPM). En prod se ignora via docker-compose.prod.yml
BACKEND_PORT=7090
# Puerto para acceder al frontend directo (sin NPM)
FRONTEND_PORT=6060

# ---------- Base de datos ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=osteoperu_resultados
DB_USER=
DB_PASSWORD=

# ---------- Backend Spring ----------
# Perfil Spring: 'local' (dev) o 'server' (prod). Coincide con application-{perfil}.yml
SPRING_PROFILES_ACTIVE=local
# Context-path bajo el que se sirve la API
CONTEXT_PATH=/osteoperu-api-resultados
# URL publica base (aparece en el SMS con el link corto del resultado)
PUBLIC_BASE_URL=
# URL del portal paciente (QR de la credencial generada por Admision)
PORTAL_URL=
# Origenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=
# Clave JWT HS256 (minimo 32 bytes). EN PRODUCCION USAR VALOR REAL, NO ESTE PLACEHOLDER
JWT_SECRET=cambia-esta-clave-secreta-jwt-hs256-minimo-32-bytes
# Credenciales del usuario ADMIN sembrado al arrancar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- Almacenamiento de resultados (volumen) ----------
# Path en el host que se monta en /app/uploads del backend
UPLOADS_PATH=./uploads

# ---------- Integraciones ----------
# RENIEC (lookup nombre por DNI). Token solo se usa si enabled=true
RENIEC_ENABLED=false
RENIEC_TOKEN=
# SMS gateway
SMS_ENABLED=false
SMS_API_KEY=