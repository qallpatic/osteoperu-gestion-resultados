# ============================================================
#  Configuracion de entorno - PLANTILLA
#  ------------------------------------------------------------
#  Copiar a .env.dev o .env.prod segun corresponda:
#    cp .env.example .env.dev    # desarrollo local (commiteado, valores seguros)
#    cp .env.example .env.prod   # produccion (GITIGNORED, llenar con secretos reales)
#
#  Las variables se cargan automaticamente con:
#    docker compose up -d                     # usa .env.dev por defecto
#    docker compose --env-file .env.prod ...  # prod
#  Ver DEPLOY.md para mas detalle.
# ============================================================

# ---------- Generales ----------
# TAG de imagen (latest / dev / prod / version-semver)
TAG=latest
# Archivo de entorno que docker-compose carga por defecto si no se especifica --env-file
ENV_FILE=.env.dev

# ---------- Puertos del host ----------
# Puerto para acceder al backend directamente (sin NPM). En prod se ignora via docker-compose.prod.yml
BACKEND_PORT=7090
# Puerto para acceder al frontend directo (sin NPM)
FRONTEND_PORT=6060

# ---------- Base de datos ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=osteoperu_resultados
DB_USER=
DB_PASSWORD=

# ---------- Backend Spring ----------
# Perfil Spring: 'local' (dev) o 'server' (prod). Coincide con application-{perfil}.yml
SPRING_PROFILES_ACTIVE=local
# Zona horaria del JVM dentro del contenedor. Debe ser un identificador valido de
# la IANA tz database (ej. America/Lima = UTC-5, America/Bogota = UTC-5, America/Mexico_City = UTC-6).
# Afecta a LocalDateTime.now(), logs y serializacion JSON de fechas.
TZ=America/Lima
# Context-path bajo el que se sirve la API
CONTEXT_PATH=/osteoperu-api-resultados
# URL publica base (aparece en el SMS con el link corto del resultado)
PUBLIC_BASE_URL=
# URL del portal paciente (QR de la credencial generada por Admision)
PORTAL_URL=
# Origenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=
# Clave JWT HS256 (minimo 32 bytes). EN PRODUCCION USAR VALOR REAL, NO ESTE PLACEHOLDER
JWT_SECRET=cambia-esta-clave-secreta-jwt-hs256-minimo-32-bytes
# Credenciales del usuario ADMIN sembrado al arrancar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- Almacenamiento de resultados ----------
# STORAGE_TYPE: "local" (FS del contenedor via volumen) o "s3" (S3-compatible / MinIO)
STORAGE_TYPE=local
# Path en el host que se monta en /app/uploads del backend (solo si STORAGE_TYPE=local)
UPLOADS_PATH=./uploads

# --- S3 / MinIO (usar solo si STORAGE_TYPE=s3) ---
STORAGE_S3_ENDPOINT=https://ia.qallpatic.com.pe
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PRESIGN_MINUTES=10

# ---------- Integraciones ----------
# RENIEC (lookup nombre por DNI). Token solo se usa si enabled=true
RENIEC_ENABLED=false
RENIEC_TOKEN=
# SMS gateway
SMS_ENABLED=false
SMS_API_KEY=

# ---------- Recuperacion de password ----------
# Telefono que se muestra al paciente cuando no recibe el SMS (info de soporte).
SOPORTE_TELEFONO=080012346
# Longitud de la clave temporal generada (sin 0/O/1/I).
RECUPERACION_LONGITUD_CLAVE=6
# Rate-limit por IP y por documento dentro de la ventana.
RECUPERACION_MAX_INTENTOS_IP=3
RECUPERACION_MAX_INTENTOS_TELEFONO=3
# Maximo de documentos distintos solicitados desde una misma IP en la ventana.
RECUPERACION_MAX_DISTINTOS_POR_IP=3
# Tamano de la ventana deslizante (minutos).
RECUPERACION_VENTANA_MINUTOS=10
# Retencion de la tabla de intentos (horas); purga via tarea @Scheduled.
RECUPERACION_RETENCION_HORAS=24

# ---------- Rate-limit del login (POST /api/auth/login) ----------
# Maximo de intentos por IP y por usuario en la ventana.
LOGIN_MAX_INTENTOS_IP=5
LOGIN_MAX_INTENTOS_USUARIO=5
LOGIN_VENTANA_MINUTOS=10
LOGIN_RETENCION_HORAS=24