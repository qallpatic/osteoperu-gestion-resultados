# ============================================================
#  Configuracion DEV - commiteada al repo (sin secretos reales)
#  ------------------------------------------------------------
#  Levanta el stack local con:
#    ./scripts/dev-up.sh
#    # o equivalente: docker compose up -d --build
#
#  Accesos:
#    Frontend:  http://localhost:6060/resultados/
#    Backend:   http://localhost:7090/osteoperu-api-resultados/
#    Swagger:   http://localhost:7090/osteoperu-api-resultados/swagger-ui.html
#
#  Credenciales admin:
#    usuario: admin
#    password: Admin@2026
#
#  Para produccion ver .env.example -> copiar a .env.prod (gitignored).
# ============================================================

TAG=dev
ENV_FILE=.env.dev

BACKEND_PORT=7090
FRONTEND_PORT=6060

# Apunta al MySQL del server (mismo que prod). Si querés DB local dockerizada,
# crear servicio 'db' con perfil dev en un docker-compose.override.yml aparte.
DB_HOST=161.132.53.229
DB_PORT=3306
DB_NAME=osteoperu_resultados
DB_USER=resultados_user
DB_PASSWORD=R3sultados@2026!

SPRING_PROFILES_ACTIVE=local
# Zona horaria del contenedor backend (JVM y logs). America/Lima = UTC-5 (Peru).
# Cambiar si se despliega en otra region (America/Bogota, America/Mexico_City, ...).
TZ=America/Lima
CONTEXT_PATH=/osteoperu-api-resultados
PUBLIC_BASE_URL=http://localhost:6060/osteoperu-api-resultados
PORTAL_URL=http://localhost:6060/login
CORS_ALLOWED_ORIGINS=http://localhost:6060,http://localhost:4200
JWT_SECRET=dev-only-jwt-secret-not-for-production-replace-me-32bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026

UPLOADS_PATH=/home/docker/uploads

# ---------- Almacenamiento de resultados ----------
# STORAGE_TYPE: "local" (FS del contenedor via volumen) o "s3" (MinIO/S3-compatible)
STORAGE_TYPE=s3
# --- S3 / MinIO ---
STORAGE_S3_ENDPOINT=https://ia.qallpatic.com.pe
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=osteoperu-resultados-dev-key
STORAGE_S3_SECRET_KEY=20606096225Qt@
STORAGE_S3_BUCKET=osteoperu-resultados-dev
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PRESIGN_MINUTES=10

RENIEC_ENABLED=true
RENIEC_TOKEN=sk_10724.CaV0hlik8qjqno2Opn8FZA7mzlLegx43
# SMS REAL habilitado para pruebas de recuperacion de password.
# API key del default de application.yml (device 69b88ed724a851efe4c5a68f);
# la del .env.prod (625dc792...) devolvio 401 contra el gateway el 2026-07-15.
SMS_ENABLED=true
SMS_API_KEY=576f18ae-07f5-4102-968b-57ac26f5f6dc
# Link al login del operador (se expone en el SMS como {link}).
SMS_LOGIN_URL=${PORTAL_URL:http://localhost:6060/login}

# ---------- Recuperacion de password (DEV) ----------
SOPORTE_TELEFONO=080012346
RECUPERACION_LONGITUD_CLAVE=10
RECUPERACION_MAX_INTENTOS_IP=3
RECUPERACION_MAX_INTENTOS_TELEFONO=3
RECUPERACION_MAX_DISTINTOS_POR_IP=3
RECUPERACION_VENTANA_MINUTOS=10
RECUPERACION_RETENCION_HORAS=24